{
  "name": "airvpn-history-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker collecting AirVPN public network status history into D1.",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute airvpn-history --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute airvpn-history --remote --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  }
}
