{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airvpn-history-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      // Invocation logs include request metadata (source IP among it),
      // retained 3 days on the Free plan by Cloudflare. Disabled since we
      // don't need it and don't want that IP retention. console.error calls
      // in the code still work (uncaught exceptions still surface via the
      // dashboard/wrangler tail), just no per-request invocation record.
      "invocation_logs": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airvpn-history",
      "database_id": "9b468891-b0cb-4f9b-854c-225625a27997"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 3 * * *"
    ]
  }
}
